<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Toma de Pedido</title>
    <link rel="stylesheet" href="/css/MeseroSeleccionProductos.css">
    <link rel="stylesheet" href="/css/ListaProductosPorCat.css">
</head>
<body>
    <input type="hidden" value='<%= JSON.stringify(datosMesa) %>' id='datosMesa'>
    <div class="barra-categorias">
        <% if (typeof categorias !== 'undefined' && categorias && categorias.length > 0) { %>
            <% categorias.forEach((cat) => { %>
                <button 
                    class="btn-categoria" id = "<%= cat.pacpcodcat %>"
                    onclick="cargarProductosPorCategoria('/mesero/obtenerProductos/<%= cat.pacpcodcat%>',this)"
                >
                    <%= cat.cacpnomcat %>
                </button>
            <% }) %>
        <% } else { %>
            <p style="font-size: 0.85rem; color: #64748b; padding: 4px;">No hay categorías</p>
        <% } %>
    </div>

    <div class="contenido-principal">
      
        <div id="contenedor-productos" class="panel-productos">
            productos
        </div>

        <div class="panel-pedido" id ='contenedor-detalle'>
            
            detalle del pedido
        </div>
    </div>

    <div class="barra-inferior">
        <div class="fila-total">
            <span class="lbl-total">Total a Pagar:</span>
            <span class="monto-total" id="txt-total">Bs. 0.00</span>
        </div>
        <button class="btn-enviar" id="btn-enviar-pedido" onclick="enviarPedido('/mesero/guardar/pedido')">Enviar Pedido</button>
    </div>

   <script src="/js/MeseroSeleccionProductos.js"></script>
</body>
</html>