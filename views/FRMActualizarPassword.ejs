<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Actualizar Contraseña</title>
    <link rel="stylesheet" href="/css/FRMActualizarPassword.css">
  </head>
  <body>
    <main class="tarjeta">
      <h2>Nueva Contraseña</h2>

      <form id="formCambiarClave" action="/login/nuevaClave" method="post">
        <input type="hidden" name="causnomlog" id="idUsuario" value="<%= usuario.causnomlog %>">
        <div class="campo">
          <label>Usuario</label>
          <p><%= usuario.causnomlog %></p>
        </div>
        <div class="campo">
          <label for="nuevaClave">Nueva Contraseña</label>
          <input
          name="causpasswo"
            type="password"
            id="nuevaClave"
            required
            placeholder="Ingresa tu nueva clave"
            onkeyup="validarClave()"
            required
          />
        </div>
        <p class="error" id="cajaErrorNuevaClave"></p>

        <div class="campo">
          <label for="confirmarClave">Confirmar Contraseña</label>
          <input
            type="password"
            id="confirmarClave"
            required
            placeholder="Repite tu nueva clave"
            required
          />
        </div>

        <p class="error" id="cajaError"></p>

        <button type="submit">Actualizar</button>
      </form>
    </main>

    <script>
      let ban = false;
      const formulario = document.getElementById("formCambiarClave");
      formulario.addEventListener("submit", (e) => {
        const campoClave = document.getElementById("nuevaClave").value;
        const confirmarClave = document.getElementById("confirmarClave").value;
        const cajaError = document.getElementById("cajaError");
        cajaError.textContent = "";

        if (ban) {
          if (campoClave == confirmarClave) {
            window.alert("calve correcta");
          } else {
            cajaError.textContent = "No coinciden las claves";
            e.preventDefault();
          }
        } else {
          e.preventDefault();
        }
      });
      function validarClave() {
        const campoClave = document.getElementById("nuevaClave").value;
        const cajaErrorNuevaClave = document.getElementById(
          "cajaErrorNuevaClave",
        );

        cajaErrorNuevaClave.textContent = "";

        if (
          /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[\W_]).{8,}$/.test(campoClave)
        ) {
          ban = true;
          cajaErrorNuevaClave.textContent = "";
        } else {
          cajaErrorNuevaClave.textContent = "Clave debil";
          ban = false;
        }

        if (campoClave.length == 0) {
          cajaErrorNuevaClave.textContent = "";
        }
      }
    </script>
  </body>
</html>
