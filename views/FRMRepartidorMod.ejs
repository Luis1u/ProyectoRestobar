<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modificar Repartidor</title>
    
</head>
<body>

    <div class="contenedor-formulario">
        <h2>Modificar Repartidor</h2>
        
        <form id="formularioRepartidor" onsubmit="EnviarFormulario(event,'modificar','formularioRepartidor', '/repartidor/Modificar/<%= Repartidor.papscodper%>')">
            <div class="grupo-campo">
                <label for="numeroCi">Numero de CI</label>
                <input type="number" id="numeroCi" name="capsnumcid" value = "<%= Repartidor.capsnumcid %>"  required >
                <p id="cjaErrorNumerCi" class="cjaError"></p>
            </div>

            <div class="grupo-campo">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="capsnomper" value = "<%= Repartidor.capsnomper %>" required oninput="convertirMayusculas(this)"
            style="text-transform: uppercase">
                <p id="cjaErrorNombre" class="cjaError"></p>
            </div>

            <div class="grupo-campo">
                <label for="apellidoPaterno">Apellido paterno</label>
                <input type="text" id="apellidoPaterno" name="capsapepat" value = "<%= Repartidor.capsapepat %>" required oninput="convertirMayusculas(this)"
            style="text-transform: uppercase">
                <p id="cjaErrorApellidoPaterno" class="cjaError"></p>
            </div>

            <div class="grupo-campo">
                <label for="apellidoMaterno">Apellido Materno</label>
                <input type="text" id="apellidoMaterno" name="capsapemat" value="<%= Repartidor.capsapemat %>"  oninput="convertirMayusculas(this)"
            style="text-transform: uppercase">
                <p id="cjaErrorApellidoMaterno" class="cjaError"></p>
            </div>

            <div class="grupo-campo">
                <label for="fechaIngreso">Fecha de Ingreso</label>
                <input type="date" id="fechaIngreso" name="capsfecing" value="<%= Repartidor.capsfecing %>" >
                <p id="cjaErrorFechaIngreso" class="cjaError"></p>
            </div>

            <div class="grupo-campo">
                <label for="sueldo">Sueldo</label>
                <input type="number" id="sueldo" name="capssueper" value="<%= Repartidor.capssueper %>" required>
                <p id="cjaErrorSueldo" class="cjaError"></p>
            </div>

            <div class="grupo-campo">
                <label for="celular">Celular</label>
                <input type="number" id="celular" name="capsnumcel" value="<%= Repartidor.capsnumcel %>" required>
                <p id="cjaErrorCelular" class="cjaError"></p>
            </div>
            <% if(Repartidor.caraestrep == "Activo") { %>
                <div class="grupo-campo">
                    <label for="estadoRepartidor">Estado</label>
                    <select name="caraestrep" id="estadoRepartidor">
                        <option value="true" selected>Activo</option>
                        <option value="false" >Inactivo</option>
                    </select>
                </div>
                <% }else {%>
                    <div class="grupo-campo">
                        <label for="estadoRepartidor">Estado</label>
                        <select name="caraestrep" id="estadoRepartidor">
                            <option value="true">Activo</option>
                            <option value="false" selected>Inactivo</option>
                        </select>
                    </div>
                    
            <% } %>


            
            <div class="acciones-formulario">
                <button type="submit" class="boton boton-primario">Modificar</button>
                <button type="button" class="boton boton-secundario" onclick="ActualizarContenido(null, '/repartidor')">Cancelar</button>
            </div>
        </form>
    </div>

</body>
</html>