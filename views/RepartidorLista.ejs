
  


<div class="container">
  <h2>Listado de Personas</h2>

  <!-- Barra Superior: Buscador y Botón Nuevo -->
  <div class="top-bar">
    <input type="text" id="searchInput" class="search-box" placeholder="Buscar por CI, nombre, apellido..." onkeyup="filtrarTabla()">
    <a onclick="verRepartidor('/repartidor/nuevo')" class="btn btn-primary">+ Nuevo</a>
  </div>

  <!-- Tabla de Datos -->
  <table>
    <thead>
      <tr>
        <th>Nro</th>
        <th>CI</th>
        <th>Nombre</th>
        <th>Apellido Paterno</th>
        <th>Celular</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody id="tablaCuerpo">
      <% if (personas && personas.length > 0) { %>
        <% personas.forEach((persona, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= persona.capsnumcid %></td>
            <td><%= persona.capsnomper %></td>
            <td><%= persona.capsapepat %></td>
            <td><%= persona.capsnumcel %></td>
            <td>
              <div class="actions">
                <!-- Ver -->
                <button type="button" class="btn btn-info" onclick="ActualizarContenido(event, `/repartidor/ver/${'<%= persona.papscodper %>'}`)">Ver</button>
                
                <!-- Modificar -->
                <button type="button" class="btn btn-warning" onclick="ActualizarContenido(event, `/repartidor/prepMod/${'<%= persona.papscodper %>'}`)">Modificar</button>
                
                <!-- Eliminar -->
                 <% if(persona.caraestrep == true){ %>
                  <button type="button" class="btn btn-danger" onclick="ActualizarContenido(event, `/repartidor/eliminar/${'<%= persona.papscodper %>'}`)">Eliminar</button>
                  <% } else { %>
                    
                    <button type="button" class="btn btn-darAlta" onclick="ActualizarContenido(event, `/repartidor/darAlta/${'<%= persona.papscodper %>'}`)">Dar Alta</button>
               <% } %>
                </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="6" style="text-align: center;">No se encontraron registros.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>