<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Agregar Persona</title>
  </head>
  <body>
    <div class="contenedor-formulario">
      <h2>Modificar Persona</h2>

      <form
        id="formularioPersona"
        onsubmit="
          EnviarFormularioPersona(
            event,
            'modificar',
            'formularioPersona',
            '/persona/modificar/<%= persona.papscodper %>',
          )
        "
     
      >
        <!-- Número de C.I. -->
        <div class="grupo-campo">
          <label for="numeroCi">Número de C.I.</label>
          <input
            value="<%= persona.capsnumcid %>"
            type="number"
            id="numeroCi"
            name="capsnumcid"
            required
            oninput="convertirMayusculas(this)"
            style="text-transform: uppercase"
          />
          <p id="cjaErrorCapsnumcid" class="cjaError"></p>
        </div>

        <!-- Nombre -->
        <div class="grupo-campo">
          <label for="nombre">Nombre</label>
          <input
            value="<%= persona.capsnomper %>"
            type="text"
            id="nombre"
            name="capsnomper"
            required
            oninput="convertirMayusculas(this)"
            style="text-transform: uppercase"
          />
          <p id="cjaErrorCapsnomper" class="cjaError"></p>
        </div>

        <!-- Apellido Paterno -->
        <div class="grupo-campo">
          <label for="apellidoPaterno">Apellido Paterno</label>
          <input
          value="<%= persona.capsapepat %>"
            type="text"
            id="apellidoPaterno"
            name="capsapepat"
            required
            oninput="convertirMayusculas(this)"
            style="text-transform: uppercase"
          />
          <p id="cjaErrorCapsapepat" class="cjaError"></p>
        </div>

        <!-- Apellido Materno -->
        <div class="grupo-campo">
          <label for="apellidoMaterno">Apellido Materno</label>
          <input
          value="<%= persona.capsapemat %>"
            type="text"
            id="apellidoMaterno"
            name="capsapemat"
            oninput="convertirMayusculas(this)"
            style="text-transform: uppercase"
          />
          <p id="cjaErrorCapsapemat" class="cjaError"></p>
        </div>

        <!-- Fecha de Nacimiento -->
        <div class="grupo-campo">
          <label for="fechaNacimiento">Fecha de Nacimiento</label>
          <input type="date" id="fechaNacimiento" name="capsfecnac" value="<%= persona.capsfecnac %>" required />
          <p id="cjaErrorCapsfecnac" class="cjaError"></p>
        </div>

        <!-- Sexo / Género -->
        <% if(persona.capssexper == true) { %>
                <div class="grupo-campo">
          <label for="sexoPersona">Sexo</label>
          <select name="capssexper" id="sexoPersona" required>
            <option value="true" selected>MASCULINO</option>
            <option value="false">FEMENINO</option>
          </select>
          <p id="cjaErrorCapssexper" class="cjaError"></p>
        </div>
                <% }else {%>
                    <div class="grupo-campo">
          <label for="sexoPersona">Sexo</label>
          <select name="capssexper" id="sexoPersona" required>
            <option value="true">MASCULINO</option>
            <option value="false" selected>FEMENINO</option>
          </select>
          <p id="cjaErrorCapssexper" class="cjaError"></p>
        </div>
                    
            <% } %>



        

        <!-- Celular -->
        <div class="grupo-campo">
          <label for="celular">Celular</label>
          <input type="number" id="celular" name="capsnumcel" value="<%= persona.capsnumcel %>" required />
          <p id="cjaErrorCapsnumcel" class="cjaError"></p>
        </div>

        <!-- Correo Electrónico -->
        <div class="grupo-campo">
          <label for="correoElectronico">Correo Electrónico</label>
          <input type="email" id="correoElectronico" name="capscorele" oninput="convertirMayusculas(this)" value="<%= persona.capscorele %>" required   />
          <p id="cjaErrorCapscorele" class="cjaError"></p>
        </div>

        <!-- Dirección -->
        <div class="grupo-campo">
          <label for="direccion">Dirección</label>
          <input
          value="<%= persona.capsdirper %>"
            type="text"
            id="direccion"
            name="capsdirper"
            oninput="convertirMayusculas(this)"
            style="text-transform: uppercase"
          />
          <p id="cjaErrorCapsdirper" class="cjaError"></p>
        </div>

        <!-- Estado de la Persona -->
         <% if(persona.capsestper == true) { %>
                <div class="grupo-campo">
                    <label for="estadoPersona">Estado</label>
                    <select name="capsestper" id="estado">
                        <option value="true" selected>ACTIVO</option>
                        <option value="false" >INACTIVO</option>
                    </select>
                     <p id="cjaErrorCapsestper" class="cjaError"></p>
                </div>
                <% }else {%>
                    <div class="grupo-campo">
                    <label for="estadoPersona">Estado</label>
                    <select name="capsestper" id="estado">
                        <option value="true" >ACTIVO</option>
                        <option value="false" selected>INACTIVO</option>
                    </select>
                     <p id="cjaErrorCapsestper" class="cjaError"></p>
                </div>
                    
            <% } %>

        <!-- Botones de Acción -->
        <div class="acciones-formulario">
          <button  type = "submit" class="boton boton-primario" >Guardar Cambios</button>
          <button
            type="button"
            class="boton boton-secundario"
            onclick="ActualizarContenido('/persona/lista')"
          >
            Cancelar
          </button>
        </div>
      </form>
    </div>
  </body>
</html>