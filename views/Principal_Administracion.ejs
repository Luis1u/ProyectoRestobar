<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Administracion</title>
    <link rel="stylesheet" href="/css/Principal_Administracion.css" />
    <link rel="stylesheet" href="/css/RepartidorLista.css" /> 
    <link rel="stylesheet" href="/css/FRMNuevoRepartidor.css" />
    <link rel="stylesheet" href="/css/Mensaje.css" />
  </head>
  <body>
    <div class="contenedorpadre">
      <div class="contenedor-uno">
        <div class="logo">
          <img src="/img/logoSacur.png" alt="Logo sacur" />
        </div>
        <div class="titulo">
          <h2>Usuario: <%= usuario.nombre %> <%= usuario.apellidoPaterno %></h2>
          <h2>Administracion</h2>
        </div>
        <div class="logout">
          <a href="/session/cierre" class="btn-logout">Cerrar Sesión</a>
        </div>
      </div>

      <div class="contenedor-dos">
        <div class="menu">
          <ul>
            <li class="sin-submenu">
              <a href="#">
                <img src="/img/ic_resumen.png" alt="" class="logo" />
                <p>Resumen</p>
              </a>
            </li>
            <li class="con-submenu">
              <a href="#">
                <img src="/img/ic_persona.png" alt="LogoEmpleado" class="logo" />
                <p>Personas ▾</p>
              </a>
              <ul class="submenu">
                <li><a href="#">Repartidores</a></li>
                <li><a href="#" onclick="ActualizarContenido('/persona/lista')">Lista de Personas</a></li>
                <li><a href="#" onclick="ActualizarContenido('/usuario/lista')">Lista de Usuarios</a></li>
              </ul>
            </li>

            <li class="con-submenu">
              <a href="#">
                <img src="/img/ic_producto.png" alt="" class="logo" />
                <p>Productos ▾</p>
              </a>
              <ul class="submenu">
                <li><a href="#" onclick="ActualizarContenido('/producto/lista')">Lista de Productos</a></li>
                <li><a href="#" onclick="ActualizarContenido('/producto/iniciarStockPregunta')">Iniciar stock del dia</a></li>
                <li><a href="#" onclick="ActualizarContenido('/categoria/lista')">Lista de Categorías</a></li>
              </ul>
            </li>

            <li class="sin-submenu">
              <a href="#" onclick="ActualizarContenido('/mesa/lista')">
                <img src="/img/ic_mesa.png" alt="" class="logo" />
                <p>Mesas</p>
              </a>
            </li>
            <li class="sin-submenu">
              <a href="#" onclick="ActualizarContenido('/pedido/lista')">
                <img src="/img/ic_pedido.png" alt="" class="logo" />
                <p>Pedidos</p>
              </a>
            </li>

            

            
          </ul>
        </div>

        <div class="contenedor_dinamico" id="contenedor_dinamico">
          <!-- Se cargará la vista aquí -->
        </div>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/Principal_Administracion.js"></script>
  </body>
</html>