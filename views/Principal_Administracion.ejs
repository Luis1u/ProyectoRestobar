<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=1400, initial-scale=0.3, user-scalable=yes">
    <title>Panel de Administracion</title>
    <link rel="stylesheet" href="/css/Principal_Administracion.css" />
    <link rel="stylesheet" href="/css/RepartidorLista.css" /> 
    <link rel="stylesheet" href="/css/FRMNuevoRepartidor.css" />
    <link rel="stylesheet" href="/css/Mensaje.css" />
  </head>
  <body>
    <div class="contenedorpadre">
      <div class="contenedor-uno">
        <div class="logo">
          <img src="/img/logoSacur.png" alt="Logo sacur" />
        </div>
        <div class="titulo">
          <h2>Usuario:<%= usuario.nombre %> <%= usuario.apellidoPaterno  %>
          </h2>
          <h2>Administracion</h2>
        </div>
      </div>

      <div class="contenedor-dos">
        <div class="menu">
          <ul>
            <li class="sin-submenu">
              <a href="#" onclick="ActualizarContenido('/resumen')">
                <img src="/img/ic_resumen.png" alt="" class="logo" />
                <p>Resumen</p>
              </a>
            </li>
            <li class="sin-submenu">
              <a href="#" onclick="ActualizarContenido('/persona/lista')">
                <img src="/img/ic_persona.png" alt="" class="logo" />
                <p>Personas</p>
              </a>
            </li>

            <li class="con-submenu">
              <a href="#">
                <img src="/img/ic_empleado.png" alt="LogoEmpleado" class="logo" />
                <p>Empleados ▾</p>
              </a>
              <ul class="submenu">
                <li>
                  <a href="#" onclick="ActualizarContenido('/repartidor')">Repartidores</a>
                </li>
                <li>
                  <a href="#" onclick="ActualizarContenido('/usuario/lista')">Usuarios</a>
                </li>
              </ul>
            </li>

            <li class="con-submenu">
              <a href="#">
                <img src="/img/ic_producto.png" alt="" class="logo" />
                <p>Productos ▾</p>
              </a>
              <ul class="submenu">
                <li><a href="#" onclick="ActualizarContenido('/producto/lista')">Lista de Productos</a></li>
                <li><a href="#" onclick="ActualizarContenido('/producto/iniciarStockPregunta')">Iniciar stock del dia</a></li>
                <li><a href="#" onclick="ActualizarContenido('/producto/nuevo')">Registra Nuevo Producto</a></li>
                <li><a href="#" onclick="ActualizarContenido('/categoria/lista')">Lista de Categorías</a></li>
              </ul>
            </li>

            <li class="sin-submenu">
              <a href="#" onclick="ActualizarContenido('/mesa/lista')">
                <img src="/img/ic_mesa.png" alt="" class="logo" />
                <p>Mesas</p>
              </a>
            </li>
            <li class="sin-submenu">
              <a href="#" onclick="ActualizarContenido('/pedido/lista')">
                <img src="/img/ic_pedido.png" alt="" class="logo" />
                <p>Pedidos</p>
              </a>
            </li>

            <li class="con-submenu">
              <a href="#">
                <img src="/img/ic_venta.png" alt="" class="logo" />
                <p>Ventas ▾</p>
              </a>
              <ul class="submenu">
                <li><a href="#" onclick="ActualizarContenido('/venta/historial')">Historial</a></li>
                <li><a href="#" onclick="ActualizarContenido('/venta/reportes')">Reportes</a></li>
              </ul>
            </li>

            <li class="sin-submenu">
              <a href="#" onclick="ActualizarContenido('/cliente/lista')">
                <img src="/img/ic_cliente.png" alt="" class="logo" />
                <p>Clientes</p>
              </a>
            </li>
          </ul>
        </div>

        <div class="contenedor_dinamico" id="contenedor_dinamico">
          <!-- Se cargará la vista aquí -->
        </div>
      </div>
    </div>

    <script src="/socket.io/socket.io.js"></script>
    <script src="/js/Principal_Administracion.js"></script>

    
  </body>
</html>