<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <title>Panel de Administración</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/css/Principal_Administracion.css" />
  <link rel="stylesheet" href="/css/RepartidorLista.css" />
  <link rel="stylesheet" href="/css/Formularios.css" />
  <link rel="stylesheet" href="/css/Mensaje.css" />
  <link rel="stylesheet" href="/css/MensajeConfirmacionStock.css" />
</head>

<body>

  <div class="app-layout">

    <header class="fixed-top-frame">

      <div class="app-header">

        <div class="header-left">
          <button id="btn-toggle-menu" class="btn-hamburger" type="button" aria-label="Abrir menú">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <path d="M3 12h18M3 6h18M3 18h18"/>
            </svg>
          </button>

          <div class="logo-box">
            <img src="/img/logoSacur.png" alt="Logo Sacur" class="logo-img" />
          </div>
        </div>

        <div class="header-right">
          <div class="user-badge">
            <div class="avatar">
              <%= usuario.nombre ? usuario.nombre.charAt(0).toUpperCase() : 'A' %>
            </div>
            <div class="user-info">
              <span class="user-name"><%= usuario.nombre %> <%= usuario.apellidoPaterno %></span>
              <span class="user-role">Administrador</span>
            </div>
          </div>

          <a href="/session/cierre" class="btn-logout" title="Cerrar Sesión">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            <span class="logout-text">Salir</span>
          </a>
        </div>

      </div>

      <!-- IMPORTANTE: el backdrop va DENTRO del header (antes del nav).
           Si queda afuera, su z-index compite con el del header completo
           y tapa el menú en el celular. -->
      <div class="nav-backdrop" id="nav-backdrop"></div>

      <nav class="app-navigation" id="app-navigation">

        <div class="mobile-nav-header">
          <div class="logo-box">
            <img src="/img/logoSacur.png" alt="Logo Sacur" class="logo-img" />
          </div>
          <span class="brand-title">Administracion</span>
          <button id="btn-close-menu" class="btn-close-menu" type="button" aria-label="Cerrar menú">✕</button>
        </div>

        <div class="nav-container">

          <a href="#" class="nav-item active" data-url="">
            <img src="/img/ic_resumen.png" alt="" class="nav-icon" />
            <span>Resumen</span>
          </a>

          <div class="nav-dropdown">
            <button class="nav-item dropdown-btn" type="button">
              <img src="/img/ic_persona.png" alt="" class="nav-icon" />
              <span>Personas</span>
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>

            <div class="dropdown-menu">
              <!-- Pon aquí la URL real de repartidores -->
              <a href="#" data-url="">Repartidores</a>
              <a href="#" data-url="/persona/lista">Lista de Personas</a>
              <a href="#" data-url="/usuario/lista">Lista de Usuarios</a>
            </div>
          </div>

          <div class="nav-dropdown">
            <button class="nav-item dropdown-btn" type="button">
              <img src="/img/ic_producto.png" alt="" class="nav-icon" />
              <span>Productos</span>
              <svg class="chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </button>

            <div class="dropdown-menu">
              <a href="#" data-url="/producto/lista">Lista de Productos</a>
              <a href="#" data-url="/producto/iniciarStockPregunta">Iniciar stock del día</a>
              <a href="#" data-url="/categoria/lista">Lista de Categorías</a>
            </div>
          </div>

          <a href="#" class="nav-item" data-url="/mesa/lista">
            <img src="/img/ic_mesa.png" alt="" class="nav-icon" />
            <span>Mesas</span>
          </a>

          <a href="#" class="nav-item" data-url="/pedido/lista">
            <img src="/img/ic_pedido.png" alt="" class="nav-icon" />
            <span>Pedidos</span>
          </a>

        </div>

      </nav>

    </header>

    <main class="main-workspace">
      <div class="scroll-wrapper">
        <div class="contenedor_dinamico" id="contenedor_dinamico"></div>
      </div>
    </main>

  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/Principal_Administracion.js"></script>

  <script>
    const navigation = document.getElementById('app-navigation');
    const backdrop   = document.getElementById('nav-backdrop');
    const btnToggle  = document.getElementById('btn-toggle-menu');
    const btnClose   = document.getElementById('btn-close-menu');

    function abrirMenu() {
      navigation.classList.add('is-open');
      backdrop.classList.add('is-active');
      document.body.classList.add('menu-abierto');
    }

    function cerrarMenu() {
      navigation.classList.remove('is-open');
      backdrop.classList.remove('is-active');
      document.body.classList.remove('menu-abierto');
      document.querySelectorAll('.nav-dropdown.open-mobile')
        .forEach(d => d.classList.remove('open-mobile'));
    }

    function ejecutarNavegacion(url) {
      cerrarMenu();
      if (url && typeof ActualizarContenido === 'function') {
        ActualizarContenido(url);
      }
    }

    btnToggle.addEventListener('click', function (e) {
      e.preventDefault();
      abrirMenu();
    });

    btnClose.addEventListener('click', function (e) {
      e.preventDefault();
      cerrarMenu();
    });

    backdrop.addEventListener('click', cerrarMenu);

    // Abrir/cerrar submenús en celular
    document.querySelectorAll('.dropdown-btn').forEach(function (btn) {
      btn.addEventListener('click', function (e) {
        e.preventDefault();
        if (window.innerWidth <= 900) {
          btn.parentElement.classList.toggle('open-mobile');
        }
      });
    });

    // Navegación por data-url (evita el salto de href="#")
    document.querySelectorAll('.app-navigation a[data-url]').forEach(function (link) {
      link.addEventListener('click', function (e) {
        e.preventDefault();

        document.querySelectorAll('.app-navigation .nav-item.active')
          .forEach(i => i.classList.remove('active'));

        const dropdown = link.closest('.nav-dropdown');
        (dropdown ? dropdown.querySelector('.dropdown-btn') : link).classList.add('active');

        ejecutarNavegacion(link.dataset.url);
      });
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') cerrarMenu();
    });

    window.addEventListener('resize', function () {
      if (window.innerWidth > 900) cerrarMenu();
    });
  </script>

</body>
</html>
