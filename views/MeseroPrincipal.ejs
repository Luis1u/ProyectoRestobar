<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Productos</title>
    <link rel="stylesheet" href="/css/MeseroPrincipal.css">
</head>
<body>
    <audio id="audioBar" src="/sounds/PedidoListoBar.mp3" preload="auto"></audio>
    <audio id="audioCocina" src="/sounds/PedidoListoCocina.mp3" preload="auto"></audio>
    <input type="hidden" value="<%= usuario.codigo %>" id="idMesero">

    <div class="contenedor-formulario">
        <h2>Mesero:<%= usuario.nombre %> <%= usuario.apellidoPaterno %></h2>
        
        <div class="acciones-formulario">
            <a href="/mesero/nuevoPedido" class="boton boton-secundario">
                Nuevo Pedido
            </a>

            <a href="/mesero/cancelarPedido" class="boton boton-secundario">
                Cancelar Pedido
            </a>

            <a href="#" class="boton boton-secundario">
                Agregar a un pedido
            </a>

            <a href="#" class="boton boton-secundario">
                Historial de pedidos
            </a>

           <!-- ÚNICO BOTÓN CON LA CLASE EXCLUSIVA "boton-con-badge" -->
            <a href="/mesero/pedidosListos" class="boton boton-secundario boton-con-badge">
                Pedidos Listos 
                <span id="badgePedidosListos" class="badge-listos" 
                    style="<%= typeof cantidadListos !== 'undefined' && cantidadListos > 0 ? '' : 'display: none;' %>">
                    <%= typeof cantidadListos !== 'undefined' ? cantidadListos : 0 %>
                </span>
            </a>
            <a href="/session/cierre" class="boton boton-cierre">
                Cerrar Session
            </a>
        </div>
    </div>
 <script type="module" src="/js/socket/MeseroPrincipal.js"></script>
 <script  src="/js/MeseroPrincipal.js"></script>
</body>
</html>