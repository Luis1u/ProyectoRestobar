
<div class="container">
  <h2>Listado de mesas</h2>

  <!-- Barra Superior: Buscador y Botón Nuevo -->
  <div class="top-bar">
    <input type="text" id="searchInput" class="search-box" placeholder="Buscar por nombre, descripcion" onkeyup="filtrarTabla()">
    <a onclick="ActualizarContenido('/mesa/nuevo')" class="btn btn-primary">+ Nuevo</a>
  </div>

  <!-- Tabla de Datos -->
  <table>
    <thead>
      <tr>
        <th>Nro</th>
        <th>Numero de mesa</th>
        <th>Estado </th>
        <th>Capacidad</th>
        <th>Descripcion</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody id="tablaCuerpo">
      <% if (mesas && mesas.length > 0) { %>
        <% mesas.forEach((mesa, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= mesa.camlnummes %></td>
            <td><%= mesa.camlestmes %></td>
            <td><%= mesa.camlcapmes %></td>
            <td><%= mesa.camldesmes %></td>
            <td>
              <div class="actions">
                <!-- Ver -->
                <button type="button" class="btn btn-info" onclick="ActualizarContenido(`/mesa/ver/${'<%= mesa.pamlcodmes %>'}`)">Ver</button>
                
                
                <!-- Modificar -->
                <button type="button" class="btn btn-warning" onclick="ActualizarContenido(`/mesa/prepMod/${'<%= mesa.pamlcodmes %>'}`)">Modificar</button>
                
                <!-- Eliminar -->
                 <% if(mesa.camlactmes == true){ %>
                  <button type="button" class="btn btn-danger" onclick="ActualizarContenido(`/mesa/eliminar/${'<%= mesa.pamlcodmes %>'}`)">Eliminar</button>
                  <% } else { %>
                    
                    <button type="button" class="btn btn-darAlta" onclick="ActualizarContenido(`/mesa/darAlta/${'<%= mesa.pamlcodmes %>'}`)">Dar Alta</button>
               <% } %>
                </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="6" style="text-align: center;">No se encontraron registros.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>