<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bartender - Lista de Pedidos</title>
  <link rel="stylesheet" href="/css/PedidosEspera.css">
  <link rel="stylesheet" href="/css/BarPrincipal.css">
  
</head>
<body>

  <!-- CONTENEDOR FIJO DE NAVEGACIÓN -->
  <div class="header-fijo-container">
    <div class="header-fijo-contenido">
      <header class="encabezado">
        <h2>Bartender: <%= bartender.nombre %> <%= bartender.apellidoPaterno %></h2>
        <h3>Lista de Pedidos</h3>
      </header>

      <nav class="barra-filtros">
        <button class="boton-filtro activo" onclick="cargarPedidos('/bartender/espera/bar', this)">EN ESPERA</button>
        <button class="boton-filtro" onclick="cargarPedidos('', this)">EN PREPARACIÓN</button>
        <button class="boton-filtro" onclick="cargarPedidos('', this)">LISTOS</button>
        <button class="boton-filtro cierre" onclick="cargarPedidos('/session/cierre', this)">CERRAR SESSION</button>
      </nav>
    </div>
  </div>

  <!-- CONTENIDO PRINCIPAL SCROLLABLE -->
  <div class="contenedor-principal">
    <main id="contenedor-pedidos" class="lista-pedidos">
      <!-- Se carga la vista dinamica por fetch -->
    </main>
  </div>

 <script src="/js/BarPrincipal.js"></script>
  <script type="module" src="/js/socket/BarPrincipal.js"></script>
</body>
</html>