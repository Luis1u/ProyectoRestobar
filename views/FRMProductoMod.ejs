<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Modificar Producto</title>
  </head>
  <body>
    <div class="contenedor-formulario">
      <h2>Modificar Producto</h2>

      <form
        id="formularioProducto"
        onsubmit="
          EnviarFormularioProducto(
            event,
            'modificar',
            'formularioProducto',
            '/producto/modificar/<%= producto.papdcodpro %>',
          )
        "
      >
        <!-- Categoría (FK) -->
        <div class="grupo-campo">
          <label for="categoriaProducto">Categoría</label>
          <select name="pacpcodcat" id="categoriaProducto" required>
            <% categorias.forEach(cat => { %>
              <option 
                value="<%= cat.pacpcodcat %>" 
                <%= cat.pacpcodcat === producto.fapdcodcat ? 'selected' : '' %>
              >
                <%= cat.cacpnomcat %>
              </option>
            <% }); %>
          </select>
          <p id="cjaErrorFapdcodcat" class="cjaError"></p>
        </div>

        <!-- Nombre del Producto -->
        <div class="grupo-campo">
          <label for="nombreProducto">Nombre del Producto</label>
          <input
            value="<%= producto.capdnompro %>"
            type="text"
            id="nombreProducto"
            name="capdnompro"
            required
            oninput="convertirMayusculas(this)"
            style="text-transform: uppercase"
          />
          <p id="cjaErrorCapdnompro" class="cjaError"></p>
        </div>

        <!-- Descripción -->
        <div class="grupo-campo">
          <label for="descripcionProducto">Descripción</label>
          <input
            value="<%= producto.capddespro || '' %>"
            type="text"
            id="descripcionProducto"
            name="capddespro"
            oninput="convertirMayusculas(this)"
            style="text-transform: uppercase"
          />
          <p id="cjaErrorCapddespro" class="cjaError"></p>
        </div>

        <!-- Ingredientes / Notas -->
        <div class="grupo-campo">
          <label for="ingredientesProducto">Ingredientes / Notas</label>
          <input
            value="<%= producto.capdingpro || '' %>"
            type="text"
            id="ingredientesProducto"
            name="capdingpro"
            oninput="convertirMayusculas(this)"
            style="text-transform: uppercase"
          />
          <p id="cjaErrorCapdingpro" class="cjaError"></p>
        </div>

        <!-- Stock Actual -->
        <div class="grupo-campo">
          <label for="stockProducto">Stock Actual</label>
          <input
            value="<%= producto.capdstopro %>"
            type="number"
            id="stockProducto"
            name="capdstopro"
            required
          />
          <p id="cjaErrorCapdstopro" class="cjaError"></p>
        </div>

        <!-- Precio de Venta -->
        <div class="grupo-campo">
          <label for="precioVenta">Precio de Venta (Bs.)</label>
          <input
            value="<%= producto.capdpreven %>"
            type="number"
            step="0.01"
            id="precioVenta"
            name="capdpreven"
            required
          />
          <p id="cjaErrorCapdpreven" class="cjaError"></p>
        </div>

        <!-- Cargar Foto y Previsualización Base64 -->
        <div class="grupo-campo">
          <label for="inputFotoProducto">Seleccionar Nueva Foto</label>
          <input
            type="file"
            id="inputFotoProducto"
            accept="image/*"
            onchange="convertirYPrevisualizarBase64(this, 'previewFotoProducto', 'fotoBase64')"
          />

          <!-- Previsualización de la Imagen -->
          <div style="margin-top: 10px; text-align: center;">
            <img
              id="previewFotoProducto"
              src="<%= producto.capdfotpro || '/img/sin-foto.png' %>"
              alt="Vista previa de la imagen"
              style="max-width: 200px; max-height: 200px; border-radius: 8px; border: 1px solid #ccc; object-fit: cover;"
              onerror="this.onerror=null; this.src='/img/sin-foto.png';"
            />
          </div>

          <!-- Input oculto que envía el string Base64 -->
          <input
            type="hidden"
            id="fotoBase64"
            name="capdfotpro"
            value="<%= producto.capdfotpro || '' %>"
          />
          <p id="cjaErrorCapdfotpro" class="cjaError"></p>
        </div>

        <!-- Estado del Producto -->
        <div class="grupo-campo">
          <label for="estadoProducto">Estado</label>
          <select name="capdestpro" id="estadoProducto" required>
            <option value="true" <%= producto.capdestpro ? 'selected' : '' %>>ACTIVO</option>
            <option value="false" <%= !producto.capdestpro ? 'selected' : '' %>>INACTIVO</option>
          </select>
          <p id="cjaErrorCapdestpro" class="cjaError"></p>
        </div>

        <!-- Botones de Acción -->
        <div class="acciones-formulario">
          <button type="submit" class="boton boton-primario">Guardar Cambios</button>
          <button
            type="button"
            class="boton boton-secundario"
            onclick="ActualizarContenido('/producto/lista')"
          >
            Cancelar
          </button>
        </div>
      </form>
    </div>

    <!-- Script funcional Base64 -->
    
  </body>
</html>