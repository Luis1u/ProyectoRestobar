
<div class="container">
  <h2>Listado de Categorias</h2>

  <!-- Barra Superior: Buscador y Botón Nuevo -->
  <div class="top-bar">
    <input type="text" id="searchInput" class="search-box" placeholder="Buscar por nombre, descripcion" onkeyup="filtrarTabla()">
    <a onclick="ActualizarContenido('/categoria/nuevo')" class="btn btn-primary">+ Nuevo</a>
  </div>

  <!-- Tabla de Datos -->
  <table>
    <thead>
      <tr>
        <th>Nro</th>
        <th>Nombre</th>
        <th>Descripcion</th>
        <th>Acciones</th>
      </tr>
    </thead>
    <tbody id="tablaCuerpo">
      <% if (categorias && categorias.length > 0) { %>
        <% categorias.forEach((categoria, index) => { %>
          <tr>
            <td><%= index + 1 %></td>
            <td><%= categoria.cacpnomcat %></td>
            <td><%= categoria.cacpdescat %></td>
            <td>
              <div class="actions">
                <!-- Ver -->
                <button type="button" class="btn btn-info" onclick="ActualizarContenido(`/categoria/ver/${'<%= categoria.pacpcodcat %>'}`)">Ver</button>
                
                
                <!-- Modificar -->
                <button type="button" class="btn btn-warning" onclick="ActualizarContenido(`/categoria/prepMod/${'<%= categoria.pacpcodcat %>'}`)">Modificar</button>
                
                <!-- Eliminar -->
                 <% if(categoria.cacpestcat == true){ %>
                  <button type="button" class="btn btn-danger" onclick="ActualizarContenido(`/categoria/eliminar/${'<%= categoria.pacpcodcat %>'}`)">Eliminar</button>
                  <% } else { %>
                    
                    <button type="button" class="btn btn-darAlta" onclick="ActualizarContenido(`/categoria/darAlta/${'<%= categoria.pacpcodcat %>'}`)">Dar Alta</button>
               <% } %>
                </div>
            </td>
          </tr>
        <% }) %>
      <% } else { %>
        <tr>
          <td colspan="6" style="text-align: center;">No se encontraron registros.</td>
        </tr>
      <% } %>
    </tbody>
  </table>
</div>