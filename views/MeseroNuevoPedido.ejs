<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Gestión de Mesas</title>
    <link rel="stylesheet" href="/css/MeseroNuevoPedido.css">
</head>
<body>

    <div class="contenedor-formulario">
        <h2>Mesas</h2>
        
        <div class="grid-mesas">
            <% mesas.forEach(mesa => { %>
                <% if(mesa.camlestmes == 'LIBRE' ) {%>
                <a href="/mesero/nroPersonas/<%= mesa.pamlcodmes %>"   class="tarjeta-mesa <%= mesa.camlestmes %> " data-id="<%= mesa.pamlcodmes %>">
                    Mesa<%= mesa.camlnummes %>
                    <span><%= mesa.camlestmes %></span>
                </a>
            <% }else{ %>
                    <a href="#" class="tarjeta-mesa <%= mesa.camlestmes %>" data-id="<%= mesa.pamlcodmes %>">
                    Mesa<%= mesa.camlnummes %>
                    <span><%= mesa.camlestmes %></span>
                </a>
                <%  } %>
                <% }) %>
        </div>

        <a href="/mesero/principal" class="boton boton-secundario">
            Volver a inicio
        </a>
    </div>
<script type="module" src="/js/socket/MeseroNuevoPedido.js"></script>

</body>
</html>